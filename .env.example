# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Optional: set false only if your demo Postgres provider needs insecure TLS
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Bearer token required by POST /api/admin/casper/bootstrap (mandatory in production)
ADMIN_API_TOKEN=

# Casper
CASPER_CHAIN_NAME=casper-test
# Server-only upstream. The browser uses the same-origin /api/casper/rpc proxy.
CASPER_NODE_RPC_URL=http://185.170.112.40:7777/rpc
NEXT_PUBLIC_CASPER_CHAIN_NAME=casper-test

# Contract hashes
INVOICE_REGISTRY_PACKAGE_HASH=hash-e927cc878c81a521fc5e2bfc8dd163bf40071996703d656e1562fbe448f222b1
FUNDING_VAULT_PACKAGE_HASH=hash-9fabd34fa621fa2e8c8d701e7c144b3dc410437ff302122f0144221b46a73ca3
REPAYMENT_ESCROW_PACKAGE_HASH=hash-115792ac89d97550d997761fac98106f27910657a55ea2ff26d0b9d70f4ced7f
AGENT_REPUTATION_PACKAGE_HASH=hash-b68085517c629331fbd0291b4ef8b7a92366e9c037eab7895a8766b2c5c7086b
MOCK_USD_PACKAGE_HASH=hash-fe26bc8468bbed43d8b92e9d44d27fc93759a0ba4c65c60143cd8e0865a760bb

# Relayer - server only
# Hosted/serverless: paste the full PEM value. Local fallback: use *_PRIVATE_KEY_PATH.
CASPER_ADMIN_PRIVATE_KEY_PEM=
CASPER_ADMIN_PRIVATE_KEY_PATH=
CASPER_TREASURY_PRIVATE_KEY_PEM=
CASPER_TREASURY_PRIVATE_KEY_PATH=
SETTLEMENT_RELAYER_PUBLIC_KEY=02027164c96d7810a067865fc1dccade50e8d4aa405a40f70ed258dbf6685af663f5
SETTLEMENT_RELAYER_PRIVATE_KEY_PEM=
SETTLEMENT_RELAYER_PRIVATE_KEY_PATH=
CASPER_RELAYER_PAYMENT_MOTES=2500000000
CASPER_LIFECYCLE_PAYMENT_MOTES=2500000000
AGENT_PUBLIC_KEY=02027164c96d7810a067865fc1dccade50e8d4aa405a40f70ed258dbf6685af663f5
AGENT_PRIVATE_KEY_PEM=
AGENT_PRIVATE_KEY_PATH=
RELAYER_RETRY_TOKEN=
# Optional: approve and deposit real mUSDC repayment reserve (USD cents) during bootstrap
CASPER_BOOTSTRAP_REPAYMENT_RESERVE_CENTS=
# Optional: amount minted per investor mUSDC faucet request (USD cents), defaults to 500000 ($5,000)
CASPER_FAUCET_MUSDC_CENTS=
# Optional: background sync + relayer retry loop
BACKGROUND_SYNC_INTERVAL_MS=15000
BACKGROUND_RETRY_BATCH_SIZE=25
DISABLE_BACKGROUND_JOBS=false

# CSPR.click wallet UI
NEXT_PUBLIC_CSPRCLICK_APP_ID=f9ba419c-49a1-4a88-b837-7405535d
NEXT_PUBLIC_CSPRCLICK_SCRIPT_SRC=https://cdn.cspr.click/ui/v1.12.0/csprclick-client-1.12.0.js

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_ID=pdt_0Ni3Ku2einF0djna3jDMS
DODO_ENVIRONMENT=test_mode
DODO_RETURN_URL=http://localhost:3000/checkout/success
DODO_CANCEL_URL=http://localhost:3000/checkout/cancel

# AI/OCR
# Text and vision extraction both use meta-llama/llama-4-scout-17b-16e-instruct.
GROQ_API_KEY=
